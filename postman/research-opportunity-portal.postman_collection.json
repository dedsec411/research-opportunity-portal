    {
      "name": "4. Update an opportunity",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"The new values are saved\", function () {",
              "    const opportunity = pm.response.json().opportunity;",
              "    pm.expect(opportunity.title).to.eql(\"Urdu Speech Recognition using Transformers\");",
              "    pm.expect(opportunity.available_positions).to.eql(4);",
              "    pm.expect(opportunity.application_deadline).to.eql(\"2026-12-10\");",
              "});"
            ]
          }
        }
