        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Urdu Speech Recognition using Deep Learning\",\n  \"description\": \"Build and evaluate a speech-to-text model for Urdu using open datasets.\",\n  \"research_area\": \"Natural Language Processing\",\n  \"faculty_name\": \"Dr. Ayesha Khan\",\n  \"department\": \"Artificial Intelligence\",\n  \"required_skills\": \"Python, PyTorch, Signal Processing\",\n  \"available_positions\": 2,\n  \"application_deadline\": \"2026-11-30\",\n  \"status\": \"Open\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{base_url}}/api/opportunities",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "opportunities"
          ]
        },
        "description": "Creates the first research opportunity. Expected: 201 Created."
      },
      "response": []
    },
