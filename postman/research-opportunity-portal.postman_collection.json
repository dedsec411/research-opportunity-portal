    "name": "Research Opportunity Portal API",
    "description": "Tests for the Research Opportunity Portal REST API.\n\nStart the backend first (python app.py), then send the requests from top to bottom. The three Create requests save the new IDs in the collection variables first_id, second_id and third_id, and the later requests use those IDs.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "58930585",
    "_collection_link": "https://go.postman.co/collection/58930585-7f979e6b-0b05-4c79-a15a-dfc16f854b0f?source=collection_link"
  },
  "item": [
    {
      "name": "1a. Create opportunity 1",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 201 Created\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "",
              "pm.collectionVariables.set(\"first_id\", pm.response.json().opportunity.id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
