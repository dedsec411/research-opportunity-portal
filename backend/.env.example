# Copy this file and name the copy ".env".
# In the copy, replace your_mysql_password with your own MySQL password.
# If your MySQL has no password (the XAMPP default), leave it empty:  DB_PASSWORD=
#
# The real .env file is listed in .gitignore, so your password is never uploaded to GitHub.
# After changing .env, stop the server with Ctrl+C and start it again.

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=research_portal

# Port for the Flask server
PORT=5000
